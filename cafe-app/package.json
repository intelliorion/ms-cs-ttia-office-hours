{
  "name": "cafe-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creators' Café operator app",
  "bin": {
    "cafe": "./bin/cafe.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cafe": "tsx bin/cafe.ts",
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "test-data": "node scripts/make-test-data.mjs",
    "acceptance": "tsx scripts/acceptance.mjs --fake",
    "scale": "tsx scripts/make-scale-data.mjs"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "1.28.0",
    "csv-parse": "^5.5.6",
    "d3-force-3d": "3.0.5",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "3.12.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.9.0",
    "playwright-core": "1.48.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
